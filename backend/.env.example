# Application
APP_ENV=development
APP_PORT=8000
SECRET_KEY=changeme-generate-a-secure-random-key

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Database (use the asyncpg driver)
DATABASE_URL=postgresql+asyncpg://watchman:watchman@localhost:5432/watchman

# Redis
REDIS_URL=redis://localhost:6379/0

# Anthropic / Claude
ANTHROPIC_API_KEY=your-anthropic-api-key

# Alpaca (brokerage / market data)
ALPACA_API_KEY=your-alpaca-key
ALPACA_SECRET_KEY=your-alpaca-secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# News
NEWS_API_KEY=98a1bbd614144c9d9c840ed6e608e421

# Pinecone (vector store)
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=watchman-dev

# Voyage AI (embeddings)
VOYAGE_API_KEY=your-voyage-key

# LangSmith (observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langchain-key
LANGCHAIN_PROJECT=watchman

# HuggingFace
HUGGINGFACE_API_KEY=your-huggingface-key

